{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "types": [],
    "paths": {
      "components": ["./src/components"],
      "data": ["./src/data"],
      "engine": ["./src/engine"],
      "game": ["./src/game"],
      "hooks": ["./src/hooks"],
      "i18n": ["./src/i18n"],
      "navigation": ["./src/navigation"],
      "screens": ["./src/screens"],
      "storage": ["./src/storage"],
      "stores": ["./src/stores"],
      "theme": ["./src/theme"],
      "utils": ["./src/utils"]
    }
  },
  "include": ["index.ts", "declarations.d.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/__tests__/**"]
}
